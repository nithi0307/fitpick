        <mxCell id="n7" value="A context diagram shows the whole system as a single process with the&#10;only external entity it exchanges data with. The internal processes and&#10;data stores are expanded in the Level 1 diagram." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#c8ccd4;fontSize=10;fontColor=#6b7280;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="700" y="220" width="290" height="90" as="geometry"/></mxCell>
