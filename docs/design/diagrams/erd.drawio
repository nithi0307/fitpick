<mxfile host="app.diagrams.net" type="device">
  <diagram id="erd" name="FitPick — Entity Relationship Diagram">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1"
                  connect="1" arrows="1" fold="1" page="1" pageScale="1"
                  pageWidth="1180" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="n1" value="FitPick — Entity Relationship Diagram" style="text;html=1;whiteSpace=wrap;fontSize=19;fontStyle=1;fontColor=#15161a;align=center;" vertex="1" parent="1"><mxGeometry x="0" y="10" width="1180" height="30" as="geometry"/></mxCell>
        <mxCell id="users" value="users" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#eef3ff;strokeColor=#3b6ff6;strokeWidth=1.6;fontSize=14;fontStyle=1;fontColor=#1d4ed8;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="80" width="270" height="34" as="geometry"/></mxCell>
        <mxCell id="users-body" value="PK  id              SERIAL&#10;      name            VARCHAR(100)&#10;      email           VARCHAR(255) UNIQUE&#10;      password_hash   VARCHAR(255)&#10;      created_at      TIMESTAMP" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#3b6ff6;strokeWidth=1.6;fontSize=12;fontColor=#15161a;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="60" y="113" width="270" height="94" as="geometry"/></mxCell>
        <mxCell id="clothing_items" value="clothing_items" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#eef3ff;strokeColor=#3b6ff6;strokeWidth=1.6;fontSize=14;fontStyle=1;fontColor=#1d4ed8;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="440" y="290" width="270" height="34" as="geometry"/></mxCell>
        <mxCell id="clothing_items-body" value="PK  id              SERIAL&#10;FK  user_id         INTEGER → users.id&#10;      name            VARCHAR(100)&#10;      category        VARCHAR(50)&#10;      subcategory     VARCHAR(50)&#10;      colour          VARCHAR(50)&#10;      season          VARCHAR(20)&#10;      brand           VARCHAR(80)&#10;      size            VARCHAR(20)&#10;      price           NUMERIC(8,2)&#10;      tags            TEXT[]&#10;      notes           TEXT&#10;      is_favourite    BOOLEAN&#10;      times_worn      INTEGER&#10;      created_at      TIMESTAMP" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#3b6ff6;strokeWidth=1.6;fontSize=12;fontColor=#15161a;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="440" y="323" width="270" height="254" as="geometry"/></mxCell>
        <mxCell id="outfits" value="outfits" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#eef3ff;strokeColor=#3b6ff6;strokeWidth=1.6;fontSize=14;fontStyle=1;fontColor=#1d4ed8;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="820" y="80" width="270" height="34" as="geometry"/></mxCell>
        <mxCell id="outfits-body" value="PK  id              SERIAL&#10;FK  user_id         INTEGER → users.id&#10;      name            VARCHAR(100)&#10;      occasion        VARCHAR(50)&#10;      is_favourite    BOOLEAN&#10;      created_at      TIMESTAMP" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#3b6ff6;strokeWidth=1.6;fontSize=12;fontColor=#15161a;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="820" y="113" width="270" height="110" as="geometry"/></mxCell>
        <mxCell id="outfit_items" value="outfit_items" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#eef3ff;strokeColor=#3b6ff6;strokeWidth=1.6;fontSize=14;fontStyle=1;fontColor=#1d4ed8;verticalAlign=middle;align=center;" vertex="1" parent="1"><mxGeometry x="770" y="330" width="360" height="34" as="geometry"/></mxCell>
        <mxCell id="outfit_items-body" value="PK,FK  outfit_id          INTEGER → outfits.id&#10;PK,FK  clothing_item_id   INTEGER → clothing_items.id" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#3b6ff6;strokeWidth=1.6;fontSize=12;fontColor=#15161a;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="770" y="363" width="360" height="46" as="geometry"/></mxCell>
        <mxCell id="n2" value="1 : N   owns" style="startArrow=ERone;startFill=0;endArrow=ERmany;endFill=0;edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;strokeColor=#15161a;strokeWidth=1.4;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.3;exitY=1;entryX=0;entryY=0.3;" edge="1" parent="1" source="users" target="clothing_items"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n3" value="1 : N   creates" style="startArrow=ERone;startFill=0;endArrow=ERmany;endFill=0;edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;strokeColor=#15161a;strokeWidth=1.4;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.4;entryX=0;entryY=0.4;" edge="1" parent="1" source="users" target="outfits"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n4" value="1 : N" style="startArrow=ERone;startFill=0;endArrow=ERmany;endFill=0;edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;strokeColor=#15161a;strokeWidth=1.4;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="outfits" target="outfit_items"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n5" value="1 : N" style="startArrow=ERone;startFill=0;endArrow=ERmany;endFill=0;edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;strokeColor=#15161a;strokeWidth=1.4;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" edge="1" parent="1" source="clothing_items" target="outfit_items"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n6" value="outfit_items resolves the many-to-many relationship between outfits and clothing items:&#10;an outfit contains many pieces and a piece can appear in many outfits." style="text;html=1;whiteSpace=wrap;fontSize=10;fontColor=#6b7280;align=left;" vertex="1" parent="1"><mxGeometry x="60" y="710" width="1000" height="44" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
